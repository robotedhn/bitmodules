{"entries":[{"timestamp":1792290795535,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":133,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":33,"diffs":[[1,"\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":206,"length1":41,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":233,"length1":35,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]},{"type":"added","filename":"custom.ts","value":"/**\n * Blocks for reading sensors and controlling actuators\n */\n//% weight=100 color=#0fbc11 icon=\"\\uf1b3\" block=\"BitModules\"\n//% groups=\"['Temperature - Light', 'Accelerometer', 'Compass', 'Sound (V2)', 'External Sensors', 'Actuators']\"\nnamespace BitModules {\n\n    /**\n     * Analog pin options for sensors\n     */\n    export enum AnalogPinOptions {\n        //% block=\"P0\"\n        P0 = AnalogPin.P0,\n        //% block=\"P1\"\n        P1 = AnalogPin.P1,\n        //% block=\"P2\"\n        P2 = AnalogPin.P2,\n        //% block=\"P3\"\n        P3 = AnalogPin.P3,\n        //% block=\"P4\"\n        P4 = AnalogPin.P4,\n        //% block=\"P10\"\n        P10 = AnalogPin.P10\n    }\n\n    /**\n     * Safe digital pin options for sensors and actuators\n     */\n    export enum DigitalPinOptions {\n        //% block=\"P0\"\n        P0 = DigitalPin.P0,\n        //% block=\"P1\"\n        P1 = DigitalPin.P1,\n        //% block=\"P2\"\n        P2 = DigitalPin.P2,\n        //% block=\"P6\"\n        P6 = DigitalPin.P6,\n        //% block=\"P7\"\n        P7 = DigitalPin.P7,\n        //% block=\"P8\"\n        P8 = DigitalPin.P8,\n        //% block=\"P9\"\n        P9 = DigitalPin.P9,\n        //% block=\"P16\"\n        P16 = DigitalPin.P16,\n        //% block=\"P13\"\n        P13 = DigitalPin.P13,\n        //% block=\"P14\"\n        P14 = DigitalPin.P14\n    }\n\n    // Color options for the LED dropdown menu\n    export enum LedColor {\n        //% block=\"red\"\n        Red,\n        //% block=\"yellow\"\n        Yellow,\n        //% block=\"green\"\n        Green,\n        //% block=\"blue\"\n        Blue,\n        //% block=\"white\"\n        White\n    }\n\n    /**\n     * Distance unit options for the ultrasonic sensor\n     */\n    export enum DistanceUnit {\n        //% block=\"cm\"\n        Centimeters,\n        //% block=\"inches\"\n        Inches\n    }\n\n    /**\n     * Options for the compass cardinal points dropdown menu\n     */\n    export enum CardinalPoint {\n        //% block=\"North (N)\"\n        North,\n        //% block=\"Northeast (NE)\"\n        Northeast,\n        //% block=\"East (E)\"\n        East,\n        //% block=\"Southeast (SE)\"\n        Southeast,\n        //% block=\"South (S)\"\n        South,\n        //% block=\"Southwest (SW)\"\n        Southwest,\n        //% block=\"West (W)\"\n        West,\n        //% block=\"Northwest (NW)\"\n        Northwest\n    }\n\n    /**\n     * Options for the accelerometer axes\n     */\n    export enum AccelerometerAxis {\n        //% block=\"X (left/right)\"\n        X = Dimension.X,\n        //% block=\"Y (forward/backward)\"\n        Y = Dimension.Y,\n        //% block=\"Z (up/down)\"\n        Z = Dimension.Z\n    }\n\n    // ==========================================\n    //           TEMPERATURE (BUILT-IN)\n    // ===========================================\n\n    /**\n     * Hexagonal block that returns TRUE if the built-in temperature is above the limit.\n     * @param limit degrees Celsius at which the alarm triggers\n     */\n    //% block=\"temperature rises above $limit ºC?\"\n    //% limit.defl=30\n    //% group=\"Temperature - Light\"\n    //% weight=100\n    export function temperatureAlarm(limit: number): boolean {\n        let currentTemp = input.temperature();\n        return currentTemp >= limit;\n    }\n\n    /**\n     * Hexagonal block that returns TRUE if the built-in temperature drops below the limit.\n     * @param limit degrees Celsius at which the alarm triggers\n     */\n    //% block=\"temperature falls below $limit ºC?\"\n    //% limit.defl=30\n    //% group=\"Temperature - Light\"\n    //% weight=99\n    export function temperatureAlarmDrop(limit: number): boolean {\n        let currentTemp = input.temperature();\n        return currentTemp <= limit;\n    }\n\n    /**\n     * Hexagonal block that returns TRUE if the light level is above the limit.\n     * @param limit the light level from 0 (dark) to 255 (very bright)\n     */\n    //% block=\"light level rises above $limit?\"\n    //% limit.min=0 limit.max=255 limit.defl=150\n    //% group=\"Temperature - Light\"\n    //% weight=98\n    export function lightAlarm(limit: number): boolean {\n        let currentLight = input.lightLevel();\n        return currentLight >= limit;\n    }\n\n    /**\n     * Hexagonal block that returns TRUE if the light level drops below the limit.\n     * @param limit the light level from 0 (dark) to 255 (very bright)\n     */\n    //% block=\"light level falls below $limit?\"\n    //% limit.min=0 limit.max=255 limit.defl=150\n    //% group=\"Temperature - Light\"\n    //% weight=97\n    export function lightAlarmDrop(limit: number): boolean {\n        let currentLight = input.lightLevel();\n        return currentLight <= limit;\n    }\n\n    // ==========================================\n    //           ACCELEROMETER (BUILT-IN)\n    // ===========================================\n\n    /**\n     * Measures the absolute acceleration force on a specific axis and converts it to a percentage (0 to 100％).\n     * Automatically compensates for gravity on the Z-axis.\n     * @param axis the accelerometer axis to measure\n     */\n    //% block=\"acceleration force (0-100％) on $axis axis\"\n    //% group=\"Accelerometer\"\n    //% weight=96\n    export function accelerationForce(axis: AccelerometerAxis): number {\n        let rawForce = input.acceleration(<number>axis);\n\n        if (axis === AccelerometerAxis.Z) {\n            rawForce = rawForce + 1024;\n        }\n\n        let absoluteForce = Math.abs(rawForce);\n        let percentage = Math.map(absoluteForce, 0, 1024, 0, 100);\n        return Math.round(Math.constrain(percentage, 0, 100));\n    }\n\n    /**\n     * Measures the total dynamic impact or shake force of the micro:bit (0 to 100％).\n     * Filters out standard 1G Earth gravity.\n     */\n    //% block=\"total impact force (0-100％)\"\n    //% group=\"Accelerometer\"\n    //% weight=90\n    export function totalImpactForce(): number {\n        let x = input.acceleration(Dimension.X);\n        let y = input.acceleration(Dimension.Y);\n        let z = input.acceleration(Dimension.Z);\n\n        let totalForce = Math.sqrt((x * x) + (y * y) + (z * z));\n        let impact = totalForce - 1024;\n\n        if (impact < 0) {\n            impact = 0;\n        }\n\n        let percentage = Math.map(impact, 0, 2048, 0, 100);\n        return Math.round(Math.constrain(percentage, 0, 100));\n    }\n\n    /**\n     * Calculates the tilt angle of the micro:bit.\n     * Includes a stabilizing dead zone of ±3 degrees in the center.\n     */\n    //% block=\"tilt angle\"\n    //% group=\"Accelerometer\"\n    //% weight=85\n    export function tiltAngle(): number {\n        let accX = input.acceleration(Dimension.X);\n        let accY = input.acceleration(Dimension.Y);\n\n        let radians = Math.atan2(-accX, accY);\n        let degrees = Math.round(radians * (180 / Math.PI));\n\n        if (degrees >= -3 && degrees <= 3) {\n            return 0;\n        }\n        return degrees;\n    }\n\n    /**\n     * Calculates the front tilt angle (Pitch).\n     * Flat = 0º, Tilted forward = positive values, tilted backward = negative values.\n     * Includes a stabilizing dead zone of ±3 degrees.\n     */\n    //% block=\"front tilt angle (forward/backward)\"\n    //% group=\"Accelerometer\"\n    //% weight=84\n    export function frontTiltAngle(): number {\n        let tilt = input.rotation(Rotation.Pitch);\n        if (tilt >= -3 && tilt <= 3) {\n            return 0;\n        }\n        return tilt;\n    }\n\n    /**\n     * Calculates the side tilt angle (Roll).\n     * Flat = 0º, Tilted left = negative values, tilted right = positive values.\n     * Includes a stabilizing dead zone of ±3 degrees.\n     */\n    //% block=\"side tilt angle (left/right)\"\n    //% group=\"Accelerometer\"\n    //% weight=83\n    export function sideTiltAngle(): number {\n        let tilt = input.rotation(Rotation.Roll);\n        if (tilt >= -3 && tilt <= 3) {\n            return 0;\n        }\n        return tilt;\n    }\n\n    // ==========================================\n    //              COMPASS (BUILT-IN)\n    // ===========================================\n\n    /**\n     * Returns TRUE if pointing North (0º ± 3º)\n     */\n    //% block=\"pointing North (N)?\"\n    //% group=\"Compass\"\n    export function pointingNorth(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 357 || degrees <= 3;\n    }\n\n    /**\n     * Returns TRUE if pointing Northeast (45º ± 3º)\n     */\n    //% block=\"pointing Northeast (NE)?\"\n    //% group=\"Compass\"\n    export function pointingNortheast(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 42 && degrees <= 48;\n    }\n\n    /**\n     * Returns TRUE if pointing East (90º ± 3º)\n     */\n    //% block=\"pointing East (E)?\"\n    //% group=\"Compass\"\n    export function pointingEast(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 87 && degrees <= 93;\n    }\n\n    /**\n     * Returns TRUE if pointing Southeast (135º ± 3º)\n     */\n    //% block=\"pointing Southeast (SE)?\"\n    //% group=\"Compass\"\n    export function pointingSoutheast(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 132 && degrees <= 138;\n    }\n\n    /**\n     * Returns TRUE if pointing South (180º ± 3º)\n     */\n    //% block=\"pointing South (S)?\"\n    //% group=\"Compass\"\n    export function pointingSouth(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 177 && degrees <= 183;\n    }\n\n    /**\n     * Returns TRUE if pointing Southwest (225º ± 3º)\n     */\n    //% block=\"pointing Southwest (SW)?\"\n    //% group=\"Compass\"\n    export function pointingSouthwest(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 222 && degrees <= 228;\n    }\n\n    /**\n     * Returns TRUE if pointing West (270º ± 3º)\n     */\n    //% block=\"pointing West (W)?\"\n    //% group=\"Compass\"\n    export function pointingWest(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 267 && degrees <= 273;\n    }\n\n    /**\n     * Returns TRUE if pointing Northwest (315º ± 3º)\n     */\n    //% block=\"pointing Northwest (NW)?\"\n    //% group=\"Compass\"\n    export function pointingNorthwest(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 312 && degrees <= 318;\n    }\n\n    /**\n     * Returns TRUE if the micro:bit points to the selected cardinal point from the list.\n     * It uses an accuracy margin of ±3 degrees.\n     * @param direction The cardinal point to evaluate\n     */\n    //% block=\"pointing to $direction?\"\n    //% group=\"Compass\"\n    export function pointingTo(direction: CardinalPoint): boolean {\n        let degrees = input.compassHeading();\n\n        switch (direction) {\n            case CardinalPoint.North:\n                return degrees >= 357 || degrees <= 3;\n            case CardinalPoint.Northeast:\n                return degrees >= 42 && degrees <= 48;\n            case CardinalPoint.East:\n                return degrees >= 87 && degrees <= 93;\n            case CardinalPoint.Southeast:\n                return degrees >= 132 && degrees <= 138;\n            case CardinalPoint.South:\n                return degrees >= 177 && degrees <= 183;\n            case CardinalPoint.Southwest:\n                return degrees >= 222 && degrees <= 228;\n            case CardinalPoint.West:\n                return degrees >= 267 && degrees <= 273;\n            case CardinalPoint.Northwest:\n                return degrees >= 312 && degrees <= 318;\n            default:\n                return false;\n        }\n    }\n\n    // ==========================================\n    //           SOUND (V2) (BUILT-IN)\n    // ===========================================\n\n    /**\n     * Hexagonal block that returns TRUE if the sound level is above the limit.\n     * Note: Requires micro:bit V2.\n     * @param limit the sound level from 0 (silent) to 255 (very loud)\n     */\n    //% block=\"sound level rises above $limit?\"\n    //% limit.min=0 limit.max=255 limit.defl=128\n    //% group=\"Sound (V2)\"\n    export function soundAlarm(limit: number): boolean {\n        let currentSound = input.soundLevel();\n        return currentSound >= limit;\n    }\n\n    /**\n     * Hexagonal block that returns TRUE if the sound level drops below the limit.\n     * Note: Requires micro:bit V2.\n     * @param limit2 the sound level from 0 (silent) to 255 (very loud)\n     */\n    //% block=\"sound level falls below $limit2?\"\n    //% limit2.min=0 limit2.max=255 limit2.defl=128\n    //% group=\"Sound (V2)\"\n    export function soundAlarmDrop(limit2: number): boolean {\n        let currentSound = input.soundLevel();\n        return currentSound <= limit2;\n    }\n\n    // ==========================================\n    //          EXTERNAL SENSORS\n    // ==========================================\n\n    /**\n     * Hexagonal block that returns TRUE if the PIR sensor detects motion.\n     * @param pin the digital pin where the PIR is connected\n     */\n    //% block=\"PIR detects motion on $pin?\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% group=\"External Sensors\"\n    export function pirMotion(pin: DigitalPinOptions): boolean {\n        let reading = pins.digitalReadPin(<number>pin);\n        return reading === 1;\n    }\n\n    /**\n     * Base block: Measures distance in centimeters.\n     * @param pinTrig pin that emits the sound\n     * @param pinEcho pin that listens for the bounce\n     */\n    //% block=\"ultrasonic distance (cm) | Trig $pinTrig | Echo $pinEcho\"\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\n    //% group=\"External Sensors\"\n    export function measureDistance(pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): number {\n        pins.digitalWritePin(<number>pinTrig, 0);\n        control.waitMicros(2);\n        pins.digitalWritePin(<number>pinTrig, 1);\n        control.waitMicros(10);\n        pins.digitalWritePin(<number>pinTrig, 0);\n\n        let duration = pins.pulseIn(<number>pinEcho, PulseValue.High, 25000);\n        let distance = duration / 58;\n\n        if (distance <= 0 || distance > 400) {\n            return 0;\n        }\n        return Math.round(distance);\n    }\n\n    /**\n     * Advanced block: Measures distance choosing between cm or inches.\n     * @param unit choose centimeters or inches\n     * @param pinTrig pin that emits the sound\n     * @param pinEcho pin that listens for the bounce\n     */\n    //% block=\"ultrasonic distance in $unit | Trig $pinTrig | Echo $pinEcho\"\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\n    //% group=\"External Sensors\"\n    export function measureDistanceUnits(unit: DistanceUnit, pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): number {\n        let distanceCm = measureDistance(pinTrig, pinEcho);\n\n        if (unit === DistanceUnit.Centimeters) {\n            return distanceCm;\n        } else {\n            return Math.round(distanceCm / 2.54);\n        }\n    }\n\n    /**\n     * Logic block (Hexagonal): Returns TRUE if there is an object closer than the indicated limit.\n     * @param limit maximum distance in cm to react\n     * @param pinTrig pin that emits the sound\n     * @param pinEcho pin that listens for the bounce\n     */\n    //% block=\"obstacle closer than $limit cm? | Trig $pinTrig | Echo $pinEcho\"\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\n    //% limit.defl=10\n    //% group=\"External Sensors\"\n    export function detectObstacle(limit: number, pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): boolean {\n        let distance = measureDistance(pinTrig, pinEcho);\n        return distance > 0 && distance <= limit;\n    }\n\n    /**\n     * Logic block (Hexagonal): Returns TRUE if there is an object further than the indicated limit.\n     * @param limit minimum distance in cm to react\n     * @param pinTrig pin that emits the sound\n     * @param pinEcho pin that listens for the bounce\n     */\n    //% block=\"obstacle further than $limit cm? | Trig $pinTrig | Echo $pinEcho\"\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\n    //% limit.defl=10\n    //% group=\"External Sensors\"\n    export function obstacleFurtherThan(limit: number, pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): boolean {\n        let distance = measureDistance(pinTrig, pinEcho);\n        return distance > limit || distance === 0;\n    }\n\n    /**\n     * Test block: Reads the distance and displays it on the LED screen.\n     * @param pinTrig pin that emits the sound\n     * @param pinEcho pin that listens for the bounce\n     */\n    //% block=\"show ultrasonic distance | Trig $pinTrig | Echo $pinEcho\"\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\n    //% group=\"External Sensors\"\n    export function showDistanceScreen(pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): void {\n        let distance = measureDistance(pinTrig, pinEcho);\n        basic.showNumber(distance);\n    }\n\n    /**\n     * Precise reading mode (turns off LEDs)\n     * @param activated turns power saving mode ON or OFF\n     */\n    //% block=\"precise reading mode (turn off LEDs) $activated\"\n    //% activated.shadow=\"toggleOnOff\"\n    //% activated.defl=true\n    //% group=\"External Sensors\"\n    export function preciseReadingMode(activated: boolean): void {\n        if (activated) {\n            led.enable(false);\n        } else {\n            led.enable(true);\n        }\n    }\n\n    /**\n     * Reads an external analog soil moisture sensor and returns the percentage (0-100%).\n     * @param pin the analog pin where the sensor's signal wire is connected\n     */\n    //% block=\"soil moisture sensor (0-100％) on $pin\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% group=\"External Sensors\"\n    export function readMoisture(pin: AnalogPinOptions): number {\n        let rawValue = pins.analogReadPin(<number>pin);\n        let mappedValue = Math.map(rawValue, 0, 1023, 0, 100);\n        return Math.round(Math.constrain(mappedValue, 0, 100));\n    }\n\n    /**\n     * Reads an external analog light sensor and returns the percentage (0-100%).\n     * @param pin the analog pin where the sensor's signal wire is connected\n     */\n    //% block=\"external light sensor (0-100％) on $pin\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% group=\"External Sensors\"\n    export function readExternalLight(pin: AnalogPinOptions): number {\n        let rawValue = pins.analogReadPin(<number>pin);\n        let mappedValue = Math.map(rawValue, 0, 1023, 0, 100);\n        return Math.round(Math.constrain(mappedValue, 0, 100));\n    }\n\n    /**\n     * Reads a potentiometer and returns the percentage (0-100%).\n     * @param pin the analog pin where the sensor's signal wire is connected\n     */\n    //% block=\"potentiometer (0-100％) on $pin\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% group=\"External Sensors\"\n    export function readPotentiometer(pin: AnalogPinOptions): number {\n        let rawValue = pins.analogReadPin(<number>pin);\n        let mappedValue = Math.map(rawValue, 0, 1023, 0, 100);\n        return Math.round(Math.constrain(mappedValue, 0, 100));\n    }\n\n    // ==========================================\n    //               ACTUATORS\n    // ==========================================\n\n    /**\n     * Turns a digital LED ON or OFF.\n     * @param pin the digital pin connected to the LED\n     * @param on ON to turn on the LED, OFF to turn it off\n     */\n    //% block=\"LED on $pin state $on\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% on.shadow=\"toggleOnOff\"\n    //% on.defl=true\n    //% group=\"Actuators\"\n    export function controlLed(pin: DigitalPinOptions, on: boolean): void {\n        pins.digitalWritePin(<number>pin, on ? 1 : 0);\n    }\n\n    /**\n     * Turns a colored LED ON or OFF.\n     * @param ledColor the color label of the LED\n     * @param pin the digital pin connected to the LED\n     * @param on ON to turn on the LED, OFF to turn it off\n     */\n    //% block=\"$ledColor LED on $pin state $on\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% on.shadow=\"toggleOnOff\"\n    //% on.defl=true\n    //% group=\"Actuators\"\n    export function controlColoredLed(ledColor: LedColor, pin: DigitalPinOptions, on: boolean): void {\n        pins.digitalWritePin(<number>pin, on ? 1 : 0);\n    }\n\n    /**\n     * Turns a relay ON or OFF.\n     * @param pin the digital pin connected to the relay\n     * @param on ON to turn on the relay, OFF to turn it off\n     */\n    //% block=\"relay on $pin state $on\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% on.shadow=\"toggleOnOff\"\n    //% on.defl=true\n    //% group=\"Actuators\"\n    export function controlRelay(pin: DigitalPinOptions, on: boolean): void {\n        pins.digitalWritePin(<number>pin, on ? 1 : 0);\n    }\n\n    /**\n     * Moves a servomotor to a specific angle (0 to 180 degrees).\n     * @param pin the pin where the servo's signal wire is connected\n     * @param angle the degrees to move the servo (0-180)\n     * @param min angle value 0, max angle value 180, default 90\n     */\n    //% block=\"move servo on $pin to $angle degrees\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% angle.min=0 angle.max=180 angle.defl=90\n    //% angle.shadow=\"protractorPicker\"\n    //% group=\"Actuators\"\n    export function moveServo(pin: DigitalPinOptions, angle: number): void {\n        pins.servoWritePin(<number>pin, angle);\n    }\n}"}]},{"timestamp":1792290990891,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":22342,"diffs":[[1,"basic.forever(function () {\n\t\n})\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":206,"length1":20,"diffs":[[1,"        \"README.md\",\n        \"custom.ts\"\n"]]},{"start1":254,"length1":31,"diffs":[[1,"    \"preferredEditor\": \"blocksprj\"\n"]]}]},{"type":"removed","filename":"custom.ts","value":"/**\n * Blocks for reading sensors and controlling actuators\n */\n//% weight=100 color=#0fbc11 icon=\"\\uf1b3\" block=\"BitModules\"\n//% groups=\"['Temperature - Light', 'Accelerometer', 'Compass', 'Sound (V2)', 'External Sensors', 'Actuators']\"\nnamespace BitModules {\n\n    /**\n     * Analog pin options for sensors\n     */\n    export enum AnalogPinOptions {\n        //% block=\"P0\"\n        P0 = AnalogPin.P0,\n        //% block=\"P1\"\n        P1 = AnalogPin.P1,\n        //% block=\"P2\"\n        P2 = AnalogPin.P2,\n        //% block=\"P3\"\n        P3 = AnalogPin.P3,\n        //% block=\"P4\"\n        P4 = AnalogPin.P4,\n        //% block=\"P10\"\n        P10 = AnalogPin.P10\n    }\n\n    /**\n     * Safe digital pin options for sensors and actuators\n     */\n    export enum DigitalPinOptions {\n        //% block=\"P0\"\n        P0 = DigitalPin.P0,\n        //% block=\"P1\"\n        P1 = DigitalPin.P1,\n        //% block=\"P2\"\n        P2 = DigitalPin.P2,\n        //% block=\"P6\"\n        P6 = DigitalPin.P6,\n        //% block=\"P7\"\n        P7 = DigitalPin.P7,\n        //% block=\"P8\"\n        P8 = DigitalPin.P8,\n        //% block=\"P9\"\n        P9 = DigitalPin.P9,\n        //% block=\"P16\"\n        P16 = DigitalPin.P16,\n        //% block=\"P13\"\n        P13 = DigitalPin.P13,\n        //% block=\"P14\"\n        P14 = DigitalPin.P14\n    }\n\n    // Color options for the LED dropdown menu\n    export enum LedColor {\n        //% block=\"red\"\n        Red,\n        //% block=\"yellow\"\n        Yellow,\n        //% block=\"green\"\n        Green,\n        //% block=\"blue\"\n        Blue,\n        //% block=\"white\"\n        White\n    }\n\n    /**\n     * Distance unit options for the ultrasonic sensor\n     */\n    export enum DistanceUnit {\n        //% block=\"cm\"\n        Centimeters,\n        //% block=\"inches\"\n        Inches\n    }\n\n    /**\n     * Options for the compass cardinal points dropdown menu\n     */\n    export enum CardinalPoint {\n        //% block=\"North (N)\"\n        North,\n        //% block=\"Northeast (NE)\"\n        Northeast,\n        //% block=\"East (E)\"\n        East,\n        //% block=\"Southeast (SE)\"\n        Southeast,\n        //% block=\"South (S)\"\n        South,\n        //% block=\"Southwest (SW)\"\n        Southwest,\n        //% block=\"West (W)\"\n        West,\n        //% block=\"Northwest (NW)\"\n        Northwest\n    }\n\n    /**\n     * Options for the accelerometer axes\n     */\n    export enum AccelerometerAxis {\n        //% block=\"X (left/right)\"\n        X = Dimension.X,\n        //% block=\"Y (forward/backward)\"\n        Y = Dimension.Y,\n        //% block=\"Z (up/down)\"\n        Z = Dimension.Z\n    }\n\n    // ==========================================\n    //           TEMPERATURE (BUILT-IN)\n    // ===========================================\n\n    /**\n     * Hexagonal block that returns TRUE if the built-in temperature is above the limit.\n     * @param limit degrees Celsius at which the alarm triggers\n     */\n    //% block=\"temperature rises above $limit ºC?\"\n    //% limit.defl=30\n    //% group=\"Temperature - Light\"\n    //% weight=100\n    export function temperatureAlarm(limit: number): boolean {\n        let currentTemp = input.temperature();\n        return currentTemp >= limit;\n    }\n\n    /**\n     * Hexagonal block that returns TRUE if the built-in temperature drops below the limit.\n     * @param limit degrees Celsius at which the alarm triggers\n     */\n    //% block=\"temperature falls below $limit ºC?\"\n    //% limit.defl=30\n    //% group=\"Temperature - Light\"\n    //% weight=99\n    export function temperatureAlarmDrop(limit: number): boolean {\n        let currentTemp = input.temperature();\n        return currentTemp <= limit;\n    }\n\n    /**\n     * Hexagonal block that returns TRUE if the light level is above the limit.\n     * @param limit the light level from 0 (dark) to 255 (very bright)\n     */\n    //% block=\"light level rises above $limit?\"\n    //% limit.min=0 limit.max=255 limit.defl=150\n    //% group=\"Temperature - Light\"\n    //% weight=98\n    export function lightAlarm(limit: number): boolean {\n        let currentLight = input.lightLevel();\n        return currentLight >= limit;\n    }\n\n    /**\n     * Hexagonal block that returns TRUE if the light level drops below the limit.\n     * @param limit the light level from 0 (dark) to 255 (very bright)\n     */\n    //% block=\"light level falls below $limit?\"\n    //% limit.min=0 limit.max=255 limit.defl=150\n    //% group=\"Temperature - Light\"\n    //% weight=97\n    export function lightAlarmDrop(limit: number): boolean {\n        let currentLight = input.lightLevel();\n        return currentLight <= limit;\n    }\n\n    // ==========================================\n    //           ACCELEROMETER (BUILT-IN)\n    // ===========================================\n\n    /**\n     * Measures the absolute acceleration force on a specific axis and converts it to a percentage (0 to 100％).\n     * Automatically compensates for gravity on the Z-axis.\n     * @param axis the accelerometer axis to measure\n     */\n    //% block=\"acceleration force (0-100％) on $axis axis\"\n    //% group=\"Accelerometer\"\n    //% weight=96\n    export function accelerationForce(axis: AccelerometerAxis): number {\n        let rawForce = input.acceleration(<number>axis);\n\n        if (axis === AccelerometerAxis.Z) {\n            rawForce = rawForce + 1024;\n        }\n\n        let absoluteForce = Math.abs(rawForce);\n        let percentage = Math.map(absoluteForce, 0, 1024, 0, 100);\n        return Math.round(Math.constrain(percentage, 0, 100));\n    }\n\n    /**\n     * Measures the total dynamic impact or shake force of the micro:bit (0 to 100％).\n     * Filters out standard 1G Earth gravity.\n     */\n    //% block=\"total impact force (0-100％)\"\n    //% group=\"Accelerometer\"\n    //% weight=90\n    export function totalImpactForce(): number {\n        let x = input.acceleration(Dimension.X);\n        let y = input.acceleration(Dimension.Y);\n        let z = input.acceleration(Dimension.Z);\n\n        let totalForce = Math.sqrt((x * x) + (y * y) + (z * z));\n        let impact = totalForce - 1024;\n\n        if (impact < 0) {\n            impact = 0;\n        }\n\n        let percentage = Math.map(impact, 0, 2048, 0, 100);\n        return Math.round(Math.constrain(percentage, 0, 100));\n    }\n\n    /**\n     * Calculates the tilt angle of the micro:bit.\n     * Includes a stabilizing dead zone of ±3 degrees in the center.\n     */\n    //% block=\"tilt angle\"\n    //% group=\"Accelerometer\"\n    //% weight=85\n    export function tiltAngle(): number {\n        let accX = input.acceleration(Dimension.X);\n        let accY = input.acceleration(Dimension.Y);\n\n        let radians = Math.atan2(-accX, accY);\n        let degrees = Math.round(radians * (180 / Math.PI));\n\n        if (degrees >= -3 && degrees <= 3) {\n            return 0;\n        }\n        return degrees;\n    }\n\n    /**\n     * Calculates the front tilt angle (Pitch).\n     * Flat = 0º, Tilted forward = positive values, tilted backward = negative values.\n     * Includes a stabilizing dead zone of ±3 degrees.\n     */\n    //% block=\"front tilt angle (forward/backward)\"\n    //% group=\"Accelerometer\"\n    //% weight=84\n    export function frontTiltAngle(): number {\n        let tilt = input.rotation(Rotation.Pitch);\n        if (tilt >= -3 && tilt <= 3) {\n            return 0;\n        }\n        return tilt;\n    }\n\n    /**\n     * Calculates the side tilt angle (Roll).\n     * Flat = 0º, Tilted left = negative values, tilted right = positive values.\n     * Includes a stabilizing dead zone of ±3 degrees.\n     */\n    //% block=\"side tilt angle (left/right)\"\n    //% group=\"Accelerometer\"\n    //% weight=83\n    export function sideTiltAngle(): number {\n        let tilt = input.rotation(Rotation.Roll);\n        if (tilt >= -3 && tilt <= 3) {\n            return 0;\n        }\n        return tilt;\n    }\n\n    // ==========================================\n    //              COMPASS (BUILT-IN)\n    // ===========================================\n\n    /**\n     * Returns TRUE if pointing North (0º ± 3º)\n     */\n    //% block=\"pointing North (N)?\"\n    //% group=\"Compass\"\n    export function pointingNorth(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 357 || degrees <= 3;\n    }\n\n    /**\n     * Returns TRUE if pointing Northeast (45º ± 3º)\n     */\n    //% block=\"pointing Northeast (NE)?\"\n    //% group=\"Compass\"\n    export function pointingNortheast(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 42 && degrees <= 48;\n    }\n\n    /**\n     * Returns TRUE if pointing East (90º ± 3º)\n     */\n    //% block=\"pointing East (E)?\"\n    //% group=\"Compass\"\n    export function pointingEast(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 87 && degrees <= 93;\n    }\n\n    /**\n     * Returns TRUE if pointing Southeast (135º ± 3º)\n     */\n    //% block=\"pointing Southeast (SE)?\"\n    //% group=\"Compass\"\n    export function pointingSoutheast(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 132 && degrees <= 138;\n    }\n\n    /**\n     * Returns TRUE if pointing South (180º ± 3º)\n     */\n    //% block=\"pointing South (S)?\"\n    //% group=\"Compass\"\n    export function pointingSouth(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 177 && degrees <= 183;\n    }\n\n    /**\n     * Returns TRUE if pointing Southwest (225º ± 3º)\n     */\n    //% block=\"pointing Southwest (SW)?\"\n    //% group=\"Compass\"\n    export function pointingSouthwest(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 222 && degrees <= 228;\n    }\n\n    /**\n     * Returns TRUE if pointing West (270º ± 3º)\n     */\n    //% block=\"pointing West (W)?\"\n    //% group=\"Compass\"\n    export function pointingWest(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 267 && degrees <= 273;\n    }\n\n    /**\n     * Returns TRUE if pointing Northwest (315º ± 3º)\n     */\n    //% block=\"pointing Northwest (NW)?\"\n    //% group=\"Compass\"\n    export function pointingNorthwest(): boolean {\n        let degrees = input.compassHeading();\n        return degrees >= 312 && degrees <= 318;\n    }\n\n    /**\n     * Returns TRUE if the micro:bit points to the selected cardinal point from the list.\n     * It uses an accuracy margin of ±3 degrees.\n     * @param direction The cardinal point to evaluate\n     */\n    //% block=\"pointing to $direction?\"\n    //% group=\"Compass\"\n    export function pointingTo(direction: CardinalPoint): boolean {\n        let degrees = input.compassHeading();\n\n        switch (direction) {\n            case CardinalPoint.North:\n                return degrees >= 357 || degrees <= 3;\n            case CardinalPoint.Northeast:\n                return degrees >= 42 && degrees <= 48;\n            case CardinalPoint.East:\n                return degrees >= 87 && degrees <= 93;\n            case CardinalPoint.Southeast:\n                return degrees >= 132 && degrees <= 138;\n            case CardinalPoint.South:\n                return degrees >= 177 && degrees <= 183;\n            case CardinalPoint.Southwest:\n                return degrees >= 222 && degrees <= 228;\n            case CardinalPoint.West:\n                return degrees >= 267 && degrees <= 273;\n            case CardinalPoint.Northwest:\n                return degrees >= 312 && degrees <= 318;\n            default:\n                return false;\n        }\n    }\n\n    // ==========================================\n    //           SOUND (V2) (BUILT-IN)\n    // ===========================================\n\n    /**\n     * Hexagonal block that returns TRUE if the sound level is above the limit.\n     * Note: Requires micro:bit V2.\n     * @param limit the sound level from 0 (silent) to 255 (very loud)\n     */\n    //% block=\"sound level rises above $limit?\"\n    //% limit.min=0 limit.max=255 limit.defl=128\n    //% group=\"Sound (V2)\"\n    export function soundAlarm(limit: number): boolean {\n        let currentSound = input.soundLevel();\n        return currentSound >= limit;\n    }\n\n    /**\n     * Hexagonal block that returns TRUE if the sound level drops below the limit.\n     * Note: Requires micro:bit V2.\n     * @param limit2 the sound level from 0 (silent) to 255 (very loud)\n     */\n    //% block=\"sound level falls below $limit2?\"\n    //% limit2.min=0 limit2.max=255 limit2.defl=128\n    //% group=\"Sound (V2)\"\n    export function soundAlarmDrop(limit2: number): boolean {\n        let currentSound = input.soundLevel();\n        return currentSound <= limit2;\n    }\n\n    // ==========================================\n    //          EXTERNAL SENSORS\n    // ==========================================\n\n    /**\n     * Hexagonal block that returns TRUE if the PIR sensor detects motion.\n     * @param pin the digital pin where the PIR is connected\n     */\n    //% block=\"PIR detects motion on $pin?\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% group=\"External Sensors\"\n    export function pirMotion(pin: DigitalPinOptions): boolean {\n        let reading = pins.digitalReadPin(<number>pin);\n        return reading === 1;\n    }\n\n    /**\n     * Base block: Measures distance in centimeters.\n     * @param pinTrig pin that emits the sound\n     * @param pinEcho pin that listens for the bounce\n     */\n    //% block=\"ultrasonic distance (cm) | Trig $pinTrig | Echo $pinEcho\"\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\n    //% group=\"External Sensors\"\n    export function measureDistance(pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): number {\n        pins.digitalWritePin(<number>pinTrig, 0);\n        control.waitMicros(2);\n        pins.digitalWritePin(<number>pinTrig, 1);\n        control.waitMicros(10);\n        pins.digitalWritePin(<number>pinTrig, 0);\n\n        let duration = pins.pulseIn(<number>pinEcho, PulseValue.High, 25000);\n        let distance = duration / 58;\n\n        if (distance <= 0 || distance > 400) {\n            return 0;\n        }\n        return Math.round(distance);\n    }\n\n    /**\n     * Advanced block: Measures distance choosing between cm or inches.\n     * @param unit choose centimeters or inches\n     * @param pinTrig pin that emits the sound\n     * @param pinEcho pin that listens for the bounce\n     */\n    //% block=\"ultrasonic distance in $unit | Trig $pinTrig | Echo $pinEcho\"\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\n    //% group=\"External Sensors\"\n    export function measureDistanceUnits(unit: DistanceUnit, pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): number {\n        let distanceCm = measureDistance(pinTrig, pinEcho);\n\n        if (unit === DistanceUnit.Centimeters) {\n            return distanceCm;\n        } else {\n            return Math.round(distanceCm / 2.54);\n        }\n    }\n\n    /**\n     * Logic block (Hexagonal): Returns TRUE if there is an object closer than the indicated limit.\n     * @param limit maximum distance in cm to react\n     * @param pinTrig pin that emits the sound\n     * @param pinEcho pin that listens for the bounce\n     */\n    //% block=\"obstacle closer than $limit cm? | Trig $pinTrig | Echo $pinEcho\"\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\n    //% limit.defl=10\n    //% group=\"External Sensors\"\n    export function detectObstacle(limit: number, pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): boolean {\n        let distance = measureDistance(pinTrig, pinEcho);\n        return distance > 0 && distance <= limit;\n    }\n\n    /**\n     * Logic block (Hexagonal): Returns TRUE if there is an object further than the indicated limit.\n     * @param limit minimum distance in cm to react\n     * @param pinTrig pin that emits the sound\n     * @param pinEcho pin that listens for the bounce\n     */\n    //% block=\"obstacle further than $limit cm? | Trig $pinTrig | Echo $pinEcho\"\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\n    //% limit.defl=10\n    //% group=\"External Sensors\"\n    export function obstacleFurtherThan(limit: number, pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): boolean {\n        let distance = measureDistance(pinTrig, pinEcho);\n        return distance > limit || distance === 0;\n    }\n\n    /**\n     * Test block: Reads the distance and displays it on the LED screen.\n     * @param pinTrig pin that emits the sound\n     * @param pinEcho pin that listens for the bounce\n     */\n    //% block=\"show ultrasonic distance | Trig $pinTrig | Echo $pinEcho\"\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\n    //% group=\"External Sensors\"\n    export function showDistanceScreen(pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): void {\n        let distance = measureDistance(pinTrig, pinEcho);\n        basic.showNumber(distance);\n    }\n\n    /**\n     * Precise reading mode (turns off LEDs)\n     * @param activated turns power saving mode ON or OFF\n     */\n    //% block=\"precise reading mode (turn off LEDs) $activated\"\n    //% activated.shadow=\"toggleOnOff\"\n    //% activated.defl=true\n    //% group=\"External Sensors\"\n    export function preciseReadingMode(activated: boolean): void {\n        if (activated) {\n            led.enable(false);\n        } else {\n            led.enable(true);\n        }\n    }\n\n    /**\n     * Reads an external analog soil moisture sensor and returns the percentage (0-100%).\n     * @param pin the analog pin where the sensor's signal wire is connected\n     */\n    //% block=\"soil moisture sensor (0-100％) on $pin\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% group=\"External Sensors\"\n    export function readMoisture(pin: AnalogPinOptions): number {\n        let rawValue = pins.analogReadPin(<number>pin);\n        let mappedValue = Math.map(rawValue, 0, 1023, 0, 100);\n        return Math.round(Math.constrain(mappedValue, 0, 100));\n    }\n\n    /**\n     * Reads an external analog light sensor and returns the percentage (0-100%).\n     * @param pin the analog pin where the sensor's signal wire is connected\n     */\n    //% block=\"external light sensor (0-100％) on $pin\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% group=\"External Sensors\"\n    export function readExternalLight(pin: AnalogPinOptions): number {\n        let rawValue = pins.analogReadPin(<number>pin);\n        let mappedValue = Math.map(rawValue, 0, 1023, 0, 100);\n        return Math.round(Math.constrain(mappedValue, 0, 100));\n    }\n\n    /**\n     * Reads a potentiometer and returns the percentage (0-100%).\n     * @param pin the analog pin where the sensor's signal wire is connected\n     */\n    //% block=\"potentiometer (0-100％) on $pin\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% group=\"External Sensors\"\n    export function readPotentiometer(pin: AnalogPinOptions): number {\n        let rawValue = pins.analogReadPin(<number>pin);\n        let mappedValue = Math.map(rawValue, 0, 1023, 0, 100);\n        return Math.round(Math.constrain(mappedValue, 0, 100));\n    }\n\n    // ==========================================\n    //               ACTUATORS\n    // ==========================================\n\n    /**\n     * Turns a digital LED ON or OFF.\n     * @param pin the digital pin connected to the LED\n     * @param on ON to turn on the LED, OFF to turn it off\n     */\n    //% block=\"LED on $pin state $on\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% on.shadow=\"toggleOnOff\"\n    //% on.defl=true\n    //% group=\"Actuators\"\n    export function controlLed(pin: DigitalPinOptions, on: boolean): void {\n        pins.digitalWritePin(<number>pin, on ? 1 : 0);\n    }\n\n    /**\n     * Turns a colored LED ON or OFF.\n     * @param ledColor the color label of the LED\n     * @param pin the digital pin connected to the LED\n     * @param on ON to turn on the LED, OFF to turn it off\n     */\n    //% block=\"$ledColor LED on $pin state $on\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% on.shadow=\"toggleOnOff\"\n    //% on.defl=true\n    //% group=\"Actuators\"\n    export function controlColoredLed(ledColor: LedColor, pin: DigitalPinOptions, on: boolean): void {\n        pins.digitalWritePin(<number>pin, on ? 1 : 0);\n    }\n\n    /**\n     * Turns a relay ON or OFF.\n     * @param pin the digital pin connected to the relay\n     * @param on ON to turn on the relay, OFF to turn it off\n     */\n    //% block=\"relay on $pin state $on\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% on.shadow=\"toggleOnOff\"\n    //% on.defl=true\n    //% group=\"Actuators\"\n    export function controlRelay(pin: DigitalPinOptions, on: boolean): void {\n        pins.digitalWritePin(<number>pin, on ? 1 : 0);\n    }\n\n    /**\n     * Moves a servomotor to a specific angle (0 to 180 degrees).\n     * @param pin the pin where the servo's signal wire is connected\n     * @param angle the degrees to move the servo (0-180)\n     * @param min angle value 0, max angle value 180, default 90\n     */\n    //% block=\"move servo on $pin to $angle degrees\"\n    //% pin.fieldEditor=\"gridpicker\"\n    //% pin.fieldOptions.columns=3\n    //% angle.min=0 angle.max=180 angle.defl=90\n    //% angle.shadow=\"protractorPicker\"\n    //% group=\"Actuators\"\n    export function moveServo(pin: DigitalPinOptions, angle: number): void {\n        pins.servoWritePin(<number>pin, angle);\n    }\n}"}]},{"timestamp":1792293110586,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":159,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"device_forever\" x=\"0\" y=\"0\"></block></xml>"]]}]}]},{"timestamp":1792298636049,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"pxt.json","patch":[{"start1":233,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"}]}],"snapshots":[{"timestamp":1792290795534,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"BitModules\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1792292782691,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"device_forever\" x=\"0\" y=\"0\"></block></xml>","main.ts":"/**\r\n * Blocks for reading sensors and controlling actuators\r\n */\r\n//% weight=100 color=#0fbc11 icon=\"\\uf1b3\" block=\"BitModules\"\r\n//% groups=\"['Temperature - Light', 'Accelerometer', 'Compass', 'Sound (V2)', 'External Sensors', 'Actuators']\"\r\nnamespace BitModules {\r\n\r\n    /**\r\n     * Analog pin options for sensors\r\n     */\r\n    export enum AnalogPinOptions {\r\n        //% block=\"P0\"\r\n        P0 = AnalogPin.P0,\r\n        //% block=\"P1\"\r\n        P1 = AnalogPin.P1,\r\n        //% block=\"P2\"\r\n        P2 = AnalogPin.P2,\r\n        //% block=\"P3\"\r\n        P3 = AnalogPin.P3,\r\n        //% block=\"P4\"\r\n        P4 = AnalogPin.P4,\r\n        //% block=\"P10\"\r\n        P10 = AnalogPin.P10\r\n    }\r\n\r\n    /**\r\n     * Safe digital pin options for sensors and actuators\r\n     */\r\n    export enum DigitalPinOptions {\r\n        //% block=\"P0\"\r\n        P0 = DigitalPin.P0,\r\n        //% block=\"P1\"\r\n        P1 = DigitalPin.P1,\r\n        //% block=\"P2\"\r\n        P2 = DigitalPin.P2,\r\n        //% block=\"P6\"\r\n        P6 = DigitalPin.P6,\r\n        //% block=\"P7\"\r\n        P7 = DigitalPin.P7,\r\n        //% block=\"P8\"\r\n        P8 = DigitalPin.P8,\r\n        //% block=\"P9\"\r\n        P9 = DigitalPin.P9,\r\n        //% block=\"P16\"\r\n        P16 = DigitalPin.P16,\r\n        //% block=\"P13\"\r\n        P13 = DigitalPin.P13,\r\n        //% block=\"P14\"\r\n        P14 = DigitalPin.P14\r\n    }\r\n\r\n    // Color options for the LED dropdown menu\r\n    export enum LedColor {\r\n        //% block=\"red\"\r\n        Red,\r\n        //% block=\"yellow\"\r\n        Yellow,\r\n        //% block=\"green\"\r\n        Green,\r\n        //% block=\"blue\"\r\n        Blue,\r\n        //% block=\"white\"\r\n        White\r\n    }\r\n\r\n    /**\r\n     * Distance unit options for the ultrasonic sensor\r\n     */\r\n    export enum DistanceUnit {\r\n        //% block=\"cm\"\r\n        Centimeters,\r\n        //% block=\"inches\"\r\n        Inches\r\n    }\r\n\r\n    /**\r\n     * Options for the compass cardinal points dropdown menu\r\n     */\r\n    export enum CardinalPoint {\r\n        //% block=\"North (N)\"\r\n        North,\r\n        //% block=\"Northeast (NE)\"\r\n        Northeast,\r\n        //% block=\"East (E)\"\r\n        East,\r\n        //% block=\"Southeast (SE)\"\r\n        Southeast,\r\n        //% block=\"South (S)\"\r\n        South,\r\n        //% block=\"Southwest (SW)\"\r\n        Southwest,\r\n        //% block=\"West (W)\"\r\n        West,\r\n        //% block=\"Northwest (NW)\"\r\n        Northwest\r\n    }\r\n\r\n    /**\r\n     * Options for the accelerometer axes\r\n     */\r\n    export enum AccelerometerAxis {\r\n        //% block=\"X (left/right)\"\r\n        X = Dimension.X,\r\n        //% block=\"Y (forward/backward)\"\r\n        Y = Dimension.Y,\r\n        //% block=\"Z (up/down)\"\r\n        Z = Dimension.Z\r\n    }\r\n\r\n    // ==========================================\r\n    //           TEMPERATURE (BUILT-IN)\r\n    // ===========================================\r\n\r\n    /**\r\n     * Hexagonal block that returns TRUE if the built-in temperature is above the limit.\r\n     * @param limit degrees Celsius at which the alarm triggers\r\n     */\r\n    //% block=\"temperature rises above $limit ºC?\"\r\n    //% limit.defl=30\r\n    //% group=\"Temperature - Light\"\r\n    //% weight=100\r\n    export function temperatureAlarm(limit: number): boolean {\r\n        let currentTemp = input.temperature();\r\n        return currentTemp >= limit;\r\n    }\r\n\r\n    /**\r\n     * Hexagonal block that returns TRUE if the built-in temperature drops below the limit.\r\n     * @param limit degrees Celsius at which the alarm triggers\r\n     */\r\n    //% block=\"temperature falls below $limit ºC?\"\r\n    //% limit.defl=30\r\n    //% group=\"Temperature - Light\"\r\n    //% weight=99\r\n    export function temperatureAlarmDrop(limit: number): boolean {\r\n        let currentTemp = input.temperature();\r\n        return currentTemp <= limit;\r\n    }\r\n\r\n    /**\r\n     * Hexagonal block that returns TRUE if the light level is above the limit.\r\n     * @param limit the light level from 0 (dark) to 255 (very bright)\r\n     */\r\n    //% block=\"light level rises above $limit?\"\r\n    //% limit.min=0 limit.max=255 limit.defl=150\r\n    //% group=\"Temperature - Light\"\r\n    //% weight=98\r\n    export function lightAlarm(limit: number): boolean {\r\n        let currentLight = input.lightLevel();\r\n        return currentLight >= limit;\r\n    }\r\n\r\n    /**\r\n     * Hexagonal block that returns TRUE if the light level drops below the limit.\r\n     * @param limit the light level from 0 (dark) to 255 (very bright)\r\n     */\r\n    //% block=\"light level falls below $limit?\"\r\n    //% limit.min=0 limit.max=255 limit.defl=150\r\n    //% group=\"Temperature - Light\"\r\n    //% weight=97\r\n    export function lightAlarmDrop(limit: number): boolean {\r\n        let currentLight = input.lightLevel();\r\n        return currentLight <= limit;\r\n    }\r\n\r\n    // ==========================================\r\n    //           ACCELEROMETER (BUILT-IN)\r\n    // ===========================================\r\n\r\n    /**\r\n     * Measures the absolute acceleration force on a specific axis and converts it to a percentage (0 to 100％).\r\n     * Automatically compensates for gravity on the Z-axis.\r\n     * @param axis the accelerometer axis to measure\r\n     */\r\n    //% block=\"acceleration force (0-100％) on $axis axis\"\r\n    //% group=\"Accelerometer\"\r\n    //% weight=96\r\n    export function accelerationForce(axis: AccelerometerAxis): number {\r\n        let rawForce = input.acceleration(<number>axis);\r\n\r\n        if (axis === AccelerometerAxis.Z) {\r\n            rawForce = rawForce + 1024;\r\n        }\r\n\r\n        let absoluteForce = Math.abs(rawForce);\r\n        let percentage = Math.map(absoluteForce, 0, 1024, 0, 100);\r\n        return Math.round(Math.constrain(percentage, 0, 100));\r\n    }\r\n\r\n    /**\r\n     * Measures the total dynamic impact or shake force of the micro:bit (0 to 100％).\r\n     * Filters out standard 1G Earth gravity.\r\n     */\r\n    //% block=\"total impact force (0-100％)\"\r\n    //% group=\"Accelerometer\"\r\n    //% weight=90\r\n    export function totalImpactForce(): number {\r\n        let x = input.acceleration(Dimension.X);\r\n        let y = input.acceleration(Dimension.Y);\r\n        let z = input.acceleration(Dimension.Z);\r\n\r\n        let totalForce = Math.sqrt((x * x) + (y * y) + (z * z));\r\n        let impact = totalForce - 1024;\r\n\r\n        if (impact < 0) {\r\n            impact = 0;\r\n        }\r\n\r\n        let percentage = Math.map(impact, 0, 2048, 0, 100);\r\n        return Math.round(Math.constrain(percentage, 0, 100));\r\n    }\r\n\r\n    /**\r\n     * Calculates the tilt angle of the micro:bit.\r\n     * Includes a stabilizing dead zone of ±3 degrees in the center.\r\n     */\r\n    //% block=\"tilt angle\"\r\n    //% group=\"Accelerometer\"\r\n    //% weight=85\r\n    export function tiltAngle(): number {\r\n        let accX = input.acceleration(Dimension.X);\r\n        let accY = input.acceleration(Dimension.Y);\r\n\r\n        let radians = Math.atan2(-accX, accY);\r\n        let degrees = Math.round(radians * (180 / Math.PI));\r\n\r\n        if (degrees >= -3 && degrees <= 3) {\r\n            return 0;\r\n        }\r\n        return degrees;\r\n    }\r\n\r\n    /**\r\n     * Calculates the front tilt angle (Pitch).\r\n     * Flat = 0º, Tilted forward = positive values, tilted backward = negative values.\r\n     * Includes a stabilizing dead zone of ±3 degrees.\r\n     */\r\n    //% block=\"front tilt angle (forward/backward)\"\r\n    //% group=\"Accelerometer\"\r\n    //% weight=84\r\n    export function frontTiltAngle(): number {\r\n        let tilt = input.rotation(Rotation.Pitch);\r\n        if (tilt >= -3 && tilt <= 3) {\r\n            return 0;\r\n        }\r\n        return tilt;\r\n    }\r\n\r\n    /**\r\n     * Calculates the side tilt angle (Roll).\r\n     * Flat = 0º, Tilted left = negative values, tilted right = positive values.\r\n     * Includes a stabilizing dead zone of ±3 degrees.\r\n     */\r\n    //% block=\"side tilt angle (left/right)\"\r\n    //% group=\"Accelerometer\"\r\n    //% weight=83\r\n    export function sideTiltAngle(): number {\r\n        let tilt = input.rotation(Rotation.Roll);\r\n        if (tilt >= -3 && tilt <= 3) {\r\n            return 0;\r\n        }\r\n        return tilt;\r\n    }\r\n\r\n    // ==========================================\r\n    //              COMPASS (BUILT-IN)\r\n    // ===========================================\r\n\r\n    /**\r\n     * Returns TRUE if pointing North (0º ± 3º)\r\n     */\r\n    //% block=\"pointing North (N)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingNorth(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 357 || degrees <= 3;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if pointing Northeast (45º ± 3º)\r\n     */\r\n    //% block=\"pointing Northeast (NE)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingNortheast(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 42 && degrees <= 48;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if pointing East (90º ± 3º)\r\n     */\r\n    //% block=\"pointing East (E)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingEast(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 87 && degrees <= 93;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if pointing Southeast (135º ± 3º)\r\n     */\r\n    //% block=\"pointing Southeast (SE)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingSoutheast(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 132 && degrees <= 138;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if pointing South (180º ± 3º)\r\n     */\r\n    //% block=\"pointing South (S)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingSouth(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 177 && degrees <= 183;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if pointing Southwest (225º ± 3º)\r\n     */\r\n    //% block=\"pointing Southwest (SW)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingSouthwest(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 222 && degrees <= 228;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if pointing West (270º ± 3º)\r\n     */\r\n    //% block=\"pointing West (W)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingWest(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 267 && degrees <= 273;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if pointing Northwest (315º ± 3º)\r\n     */\r\n    //% block=\"pointing Northwest (NW)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingNorthwest(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 312 && degrees <= 318;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if the micro:bit points to the selected cardinal point from the list.\r\n     * It uses an accuracy margin of ±3 degrees.\r\n     * @param direction The cardinal point to evaluate\r\n     */\r\n    //% block=\"pointing to $direction?\"\r\n    //% group=\"Compass\"\r\n    export function pointingTo(direction: CardinalPoint): boolean {\r\n        let degrees = input.compassHeading();\r\n\r\n        switch (direction) {\r\n            case CardinalPoint.North:\r\n                return degrees >= 357 || degrees <= 3;\r\n            case CardinalPoint.Northeast:\r\n                return degrees >= 42 && degrees <= 48;\r\n            case CardinalPoint.East:\r\n                return degrees >= 87 && degrees <= 93;\r\n            case CardinalPoint.Southeast:\r\n                return degrees >= 132 && degrees <= 138;\r\n            case CardinalPoint.South:\r\n                return degrees >= 177 && degrees <= 183;\r\n            case CardinalPoint.Southwest:\r\n                return degrees >= 222 && degrees <= 228;\r\n            case CardinalPoint.West:\r\n                return degrees >= 267 && degrees <= 273;\r\n            case CardinalPoint.Northwest:\r\n                return degrees >= 312 && degrees <= 318;\r\n            default:\r\n                return false;\r\n        }\r\n    }\r\n\r\n    // ==========================================\r\n    //           SOUND (V2) (BUILT-IN)\r\n    // ===========================================\r\n\r\n    /**\r\n     * Hexagonal block that returns TRUE if the sound level is above the limit.\r\n     * Note: Requires micro:bit V2.\r\n     * @param limit the sound level from 0 (silent) to 255 (very loud)\r\n     */\r\n    //% block=\"sound level rises above $limit?\"\r\n    //% limit.min=0 limit.max=255 limit.defl=128\r\n    //% group=\"Sound (V2)\"\r\n    export function soundAlarm(limit: number): boolean {\r\n        let currentSound = input.soundLevel();\r\n        return currentSound >= limit;\r\n    }\r\n\r\n    /**\r\n     * Hexagonal block that returns TRUE if the sound level drops below the limit.\r\n     * Note: Requires micro:bit V2.\r\n     * @param limit2 the sound level from 0 (silent) to 255 (very loud)\r\n     */\r\n    //% block=\"sound level falls below $limit2?\"\r\n    //% limit2.min=0 limit2.max=255 limit2.defl=128\r\n    //% group=\"Sound (V2)\"\r\n    export function soundAlarmDrop(limit2: number): boolean {\r\n        let currentSound = input.soundLevel();\r\n        return currentSound <= limit2;\r\n    }\r\n\r\n    // ==========================================\r\n    //          EXTERNAL SENSORS\r\n    // ==========================================\r\n\r\n    /**\r\n     * Hexagonal block that returns TRUE if the PIR sensor detects motion.\r\n     * @param pin the digital pin where the PIR is connected\r\n     */\r\n    //% block=\"PIR detects motion on $pin?\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% group=\"External Sensors\"\r\n    export function pirMotion(pin: DigitalPinOptions): boolean {\r\n        let reading = pins.digitalReadPin(<number>pin);\r\n        return reading === 1;\r\n    }\r\n\r\n    /**\r\n     * Base block: Measures distance in centimeters.\r\n     * @param pinTrig pin that emits the sound\r\n     * @param pinEcho pin that listens for the bounce\r\n     */\r\n    //% block=\"ultrasonic distance (cm) | Trig $pinTrig | Echo $pinEcho\"\r\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\r\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\r\n    //% group=\"External Sensors\"\r\n    export function measureDistance(pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): number {\r\n        pins.digitalWritePin(<number>pinTrig, 0);\r\n        control.waitMicros(2);\r\n        pins.digitalWritePin(<number>pinTrig, 1);\r\n        control.waitMicros(10);\r\n        pins.digitalWritePin(<number>pinTrig, 0);\r\n\r\n        let duration = pins.pulseIn(<number>pinEcho, PulseValue.High, 25000);\r\n        let distance = duration / 58;\r\n\r\n        if (distance <= 0 || distance > 400) {\r\n            return 0;\r\n        }\r\n        return Math.round(distance);\r\n    }\r\n\r\n    /**\r\n     * Advanced block: Measures distance choosing between cm or inches.\r\n     * @param unit choose centimeters or inches\r\n     * @param pinTrig pin that emits the sound\r\n     * @param pinEcho pin that listens for the bounce\r\n     */\r\n    //% block=\"ultrasonic distance in $unit | Trig $pinTrig | Echo $pinEcho\"\r\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\r\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\r\n    //% group=\"External Sensors\"\r\n    export function measureDistanceUnits(unit: DistanceUnit, pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): number {\r\n        let distanceCm = measureDistance(pinTrig, pinEcho);\r\n\r\n        if (unit === DistanceUnit.Centimeters) {\r\n            return distanceCm;\r\n        } else {\r\n            return Math.round(distanceCm / 2.54);\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Logic block (Hexagonal): Returns TRUE if there is an object closer than the indicated limit.\r\n     * @param limit maximum distance in cm to react\r\n     * @param pinTrig pin that emits the sound\r\n     * @param pinEcho pin that listens for the bounce\r\n     */\r\n    //% block=\"obstacle closer than $limit cm? | Trig $pinTrig | Echo $pinEcho\"\r\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\r\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\r\n    //% limit.defl=10\r\n    //% group=\"External Sensors\"\r\n    export function detectObstacle(limit: number, pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): boolean {\r\n        let distance = measureDistance(pinTrig, pinEcho);\r\n        return distance > 0 && distance <= limit;\r\n    }\r\n\r\n    /**\r\n     * Logic block (Hexagonal): Returns TRUE if there is an object further than the indicated limit.\r\n     * @param limit minimum distance in cm to react\r\n     * @param pinTrig pin that emits the sound\r\n     * @param pinEcho pin that listens for the bounce\r\n     */\r\n    //% block=\"obstacle further than $limit cm? | Trig $pinTrig | Echo $pinEcho\"\r\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\r\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\r\n    //% limit.defl=10\r\n    //% group=\"External Sensors\"\r\n    export function obstacleFurtherThan(limit: number, pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): boolean {\r\n        let distance = measureDistance(pinTrig, pinEcho);\r\n        return distance > limit || distance === 0;\r\n    }\r\n\r\n    /**\r\n     * Test block: Reads the distance and displays it on the LED screen.\r\n     * @param pinTrig pin that emits the sound\r\n     * @param pinEcho pin that listens for the bounce\r\n     */\r\n    //% block=\"show ultrasonic distance | Trig $pinTrig | Echo $pinEcho\"\r\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\r\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\r\n    //% group=\"External Sensors\"\r\n    export function showDistanceScreen(pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): void {\r\n        let distance = measureDistance(pinTrig, pinEcho);\r\n        basic.showNumber(distance);\r\n    }\r\n\r\n    /**\r\n     * Precise reading mode (turns off LEDs)\r\n     * @param activated turns power saving mode ON or OFF\r\n     */\r\n    //% block=\"precise reading mode (turn off LEDs) $activated\"\r\n    //% activated.shadow=\"toggleOnOff\"\r\n    //% activated.defl=true\r\n    //% group=\"External Sensors\"\r\n    export function preciseReadingMode(activated: boolean): void {\r\n        if (activated) {\r\n            led.enable(false);\r\n        } else {\r\n            led.enable(true);\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Reads an external analog soil moisture sensor and returns the percentage (0-100%).\r\n     * @param pin the analog pin where the sensor's signal wire is connected\r\n     */\r\n    //% block=\"soil moisture sensor (0-100％) on $pin\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% group=\"External Sensors\"\r\n    export function readMoisture(pin: AnalogPinOptions): number {\r\n        let rawValue = pins.analogReadPin(<number>pin);\r\n        let mappedValue = Math.map(rawValue, 0, 1023, 0, 100);\r\n        return Math.round(Math.constrain(mappedValue, 0, 100));\r\n    }\r\n\r\n    /**\r\n     * Reads an external analog light sensor and returns the percentage (0-100%).\r\n     * @param pin the analog pin where the sensor's signal wire is connected\r\n     */\r\n    //% block=\"external light sensor (0-100％) on $pin\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% group=\"External Sensors\"\r\n    export function readExternalLight(pin: AnalogPinOptions): number {\r\n        let rawValue = pins.analogReadPin(<number>pin);\r\n        let mappedValue = Math.map(rawValue, 0, 1023, 0, 100);\r\n        return Math.round(Math.constrain(mappedValue, 0, 100));\r\n    }\r\n\r\n    /**\r\n     * Reads a potentiometer and returns the percentage (0-100%).\r\n     * @param pin the analog pin where the sensor's signal wire is connected\r\n     */\r\n    //% block=\"potentiometer (0-100％) on $pin\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% group=\"External Sensors\"\r\n    export function readPotentiometer(pin: AnalogPinOptions): number {\r\n        let rawValue = pins.analogReadPin(<number>pin);\r\n        let mappedValue = Math.map(rawValue, 0, 1023, 0, 100);\r\n        return Math.round(Math.constrain(mappedValue, 0, 100));\r\n    }\r\n\r\n    // ==========================================\r\n    //               ACTUATORS\r\n    // ==========================================\r\n\r\n    /**\r\n     * Turns a digital LED ON or OFF.\r\n     * @param pin the digital pin connected to the LED\r\n     * @param on ON to turn on the LED, OFF to turn it off\r\n     */\r\n    //% block=\"LED on $pin state $on\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% on.shadow=\"toggleOnOff\"\r\n    //% on.defl=true\r\n    //% group=\"Actuators\"\r\n    export function controlLed(pin: DigitalPinOptions, on: boolean): void {\r\n        pins.digitalWritePin(<number>pin, on ? 1 : 0);\r\n    }\r\n\r\n    /**\r\n     * Turns a colored LED ON or OFF.\r\n     * @param ledColor the color label of the LED\r\n     * @param pin the digital pin connected to the LED\r\n     * @param on ON to turn on the LED, OFF to turn it off\r\n     */\r\n    //% block=\"$ledColor LED on $pin state $on\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% on.shadow=\"toggleOnOff\"\r\n    //% on.defl=true\r\n    //% group=\"Actuators\"\r\n    export function controlColoredLed(ledColor: LedColor, pin: DigitalPinOptions, on: boolean): void {\r\n        pins.digitalWritePin(<number>pin, on ? 1 : 0);\r\n    }\r\n\r\n    /**\r\n     * Turns a relay ON or OFF.\r\n     * @param pin the digital pin connected to the relay\r\n     * @param on ON to turn on the relay, OFF to turn it off\r\n     */\r\n    //% block=\"relay on $pin state $on\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% on.shadow=\"toggleOnOff\"\r\n    //% on.defl=true\r\n    //% group=\"Actuators\"\r\n    export function controlRelay(pin: DigitalPinOptions, on: boolean): void {\r\n        pins.digitalWritePin(<number>pin, on ? 1 : 0);\r\n    }\r\n\r\n    /**\r\n     * Moves a servomotor to a specific angle (0 to 180 degrees).\r\n     * @param pin the pin where the servo's signal wire is connected\r\n     * @param angle the degrees to move the servo (0-180)\r\n     * @param min angle value 0, max angle value 180, default 90\r\n     */\r\n    //% block=\"move servo on $pin to $angle degrees\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% angle.min=0 angle.max=180 angle.defl=90\r\n    //% angle.shadow=\"protractorPicker\"\r\n    //% group=\"Actuators\"\r\n    export function moveServo(pin: DigitalPinOptions, angle: number): void {\r\n        pins.servoWritePin(<number>pin, angle);\r\n    }\r\n}","README.md":"","pxt.json":"{\n    \"name\": \"BitModules\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1792298636049,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"device_forever\" x=\"0\" y=\"0\"></block></xml>","main.ts":"/**\r\n * Blocks for reading sensors and controlling actuators\r\n */\r\n//% weight=100 color=#0fbc11 icon=\"\\uf1b3\" block=\"BitModules\"\r\n//% groups=\"['Temperature - Light', 'Accelerometer', 'Compass', 'Sound (V2)', 'External Sensors', 'Actuators']\"\r\nnamespace BitModules {\r\n\r\n    /**\r\n     * Analog pin options for sensors\r\n     */\r\n    export enum AnalogPinOptions {\r\n        //% block=\"P0\"\r\n        P0 = AnalogPin.P0,\r\n        //% block=\"P1\"\r\n        P1 = AnalogPin.P1,\r\n        //% block=\"P2\"\r\n        P2 = AnalogPin.P2,\r\n        //% block=\"P3\"\r\n        P3 = AnalogPin.P3,\r\n        //% block=\"P4\"\r\n        P4 = AnalogPin.P4,\r\n        //% block=\"P10\"\r\n        P10 = AnalogPin.P10\r\n    }\r\n\r\n    /**\r\n     * Safe digital pin options for sensors and actuators\r\n     */\r\n    export enum DigitalPinOptions {\r\n        //% block=\"P0\"\r\n        P0 = DigitalPin.P0,\r\n        //% block=\"P1\"\r\n        P1 = DigitalPin.P1,\r\n        //% block=\"P2\"\r\n        P2 = DigitalPin.P2,\r\n        //% block=\"P6\"\r\n        P6 = DigitalPin.P6,\r\n        //% block=\"P7\"\r\n        P7 = DigitalPin.P7,\r\n        //% block=\"P8\"\r\n        P8 = DigitalPin.P8,\r\n        //% block=\"P9\"\r\n        P9 = DigitalPin.P9,\r\n        //% block=\"P16\"\r\n        P16 = DigitalPin.P16,\r\n        //% block=\"P13\"\r\n        P13 = DigitalPin.P13,\r\n        //% block=\"P14\"\r\n        P14 = DigitalPin.P14\r\n    }\r\n\r\n    // Color options for the LED dropdown menu\r\n    export enum LedColor {\r\n        //% block=\"red\"\r\n        Red,\r\n        //% block=\"yellow\"\r\n        Yellow,\r\n        //% block=\"green\"\r\n        Green,\r\n        //% block=\"blue\"\r\n        Blue,\r\n        //% block=\"white\"\r\n        White\r\n    }\r\n\r\n    /**\r\n     * Distance unit options for the ultrasonic sensor\r\n     */\r\n    export enum DistanceUnit {\r\n        //% block=\"cm\"\r\n        Centimeters,\r\n        //% block=\"inches\"\r\n        Inches\r\n    }\r\n\r\n    /**\r\n     * Options for the compass cardinal points dropdown menu\r\n     */\r\n    export enum CardinalPoint {\r\n        //% block=\"North (N)\"\r\n        North,\r\n        //% block=\"Northeast (NE)\"\r\n        Northeast,\r\n        //% block=\"East (E)\"\r\n        East,\r\n        //% block=\"Southeast (SE)\"\r\n        Southeast,\r\n        //% block=\"South (S)\"\r\n        South,\r\n        //% block=\"Southwest (SW)\"\r\n        Southwest,\r\n        //% block=\"West (W)\"\r\n        West,\r\n        //% block=\"Northwest (NW)\"\r\n        Northwest\r\n    }\r\n\r\n    /**\r\n     * Options for the accelerometer axes\r\n     */\r\n    export enum AccelerometerAxis {\r\n        //% block=\"X (left/right)\"\r\n        X = Dimension.X,\r\n        //% block=\"Y (forward/backward)\"\r\n        Y = Dimension.Y,\r\n        //% block=\"Z (up/down)\"\r\n        Z = Dimension.Z\r\n    }\r\n\r\n    // ==========================================\r\n    //           TEMPERATURE (BUILT-IN)\r\n    // ===========================================\r\n\r\n    /**\r\n     * Hexagonal block that returns TRUE if the built-in temperature is above the limit.\r\n     * @param limit degrees Celsius at which the alarm triggers\r\n     */\r\n    //% block=\"temperature rises above $limit ºC?\"\r\n    //% limit.defl=30\r\n    //% group=\"Temperature - Light\"\r\n    //% weight=100\r\n    export function temperatureAlarm(limit: number): boolean {\r\n        let currentTemp = input.temperature();\r\n        return currentTemp >= limit;\r\n    }\r\n\r\n    /**\r\n     * Hexagonal block that returns TRUE if the built-in temperature drops below the limit.\r\n     * @param limit degrees Celsius at which the alarm triggers\r\n     */\r\n    //% block=\"temperature falls below $limit ºC?\"\r\n    //% limit.defl=30\r\n    //% group=\"Temperature - Light\"\r\n    //% weight=99\r\n    export function temperatureAlarmDrop(limit: number): boolean {\r\n        let currentTemp = input.temperature();\r\n        return currentTemp <= limit;\r\n    }\r\n\r\n    /**\r\n     * Hexagonal block that returns TRUE if the light level is above the limit.\r\n     * @param limit the light level from 0 (dark) to 255 (very bright)\r\n     */\r\n    //% block=\"light level rises above $limit?\"\r\n    //% limit.min=0 limit.max=255 limit.defl=150\r\n    //% group=\"Temperature - Light\"\r\n    //% weight=98\r\n    export function lightAlarm(limit: number): boolean {\r\n        let currentLight = input.lightLevel();\r\n        return currentLight >= limit;\r\n    }\r\n\r\n    /**\r\n     * Hexagonal block that returns TRUE if the light level drops below the limit.\r\n     * @param limit the light level from 0 (dark) to 255 (very bright)\r\n     */\r\n    //% block=\"light level falls below $limit?\"\r\n    //% limit.min=0 limit.max=255 limit.defl=150\r\n    //% group=\"Temperature - Light\"\r\n    //% weight=97\r\n    export function lightAlarmDrop(limit: number): boolean {\r\n        let currentLight = input.lightLevel();\r\n        return currentLight <= limit;\r\n    }\r\n\r\n    // ==========================================\r\n    //           ACCELEROMETER (BUILT-IN)\r\n    // ===========================================\r\n\r\n    /**\r\n     * Measures the absolute acceleration force on a specific axis and converts it to a percentage (0 to 100％).\r\n     * Automatically compensates for gravity on the Z-axis.\r\n     * @param axis the accelerometer axis to measure\r\n     */\r\n    //% block=\"acceleration force (0-100％) on $axis axis\"\r\n    //% group=\"Accelerometer\"\r\n    //% weight=96\r\n    export function accelerationForce(axis: AccelerometerAxis): number {\r\n        let rawForce = input.acceleration(<number>axis);\r\n\r\n        if (axis === AccelerometerAxis.Z) {\r\n            rawForce = rawForce + 1024;\r\n        }\r\n\r\n        let absoluteForce = Math.abs(rawForce);\r\n        let percentage = Math.map(absoluteForce, 0, 1024, 0, 100);\r\n        return Math.round(Math.constrain(percentage, 0, 100));\r\n    }\r\n\r\n    /**\r\n     * Measures the total dynamic impact or shake force of the micro:bit (0 to 100％).\r\n     * Filters out standard 1G Earth gravity.\r\n     */\r\n    //% block=\"total impact force (0-100％)\"\r\n    //% group=\"Accelerometer\"\r\n    //% weight=90\r\n    export function totalImpactForce(): number {\r\n        let x = input.acceleration(Dimension.X);\r\n        let y = input.acceleration(Dimension.Y);\r\n        let z = input.acceleration(Dimension.Z);\r\n\r\n        let totalForce = Math.sqrt((x * x) + (y * y) + (z * z));\r\n        let impact = totalForce - 1024;\r\n\r\n        if (impact < 0) {\r\n            impact = 0;\r\n        }\r\n\r\n        let percentage = Math.map(impact, 0, 2048, 0, 100);\r\n        return Math.round(Math.constrain(percentage, 0, 100));\r\n    }\r\n\r\n    /**\r\n     * Calculates the tilt angle of the micro:bit.\r\n     * Includes a stabilizing dead zone of ±3 degrees in the center.\r\n     */\r\n    //% block=\"tilt angle\"\r\n    //% group=\"Accelerometer\"\r\n    //% weight=85\r\n    export function tiltAngle(): number {\r\n        let accX = input.acceleration(Dimension.X);\r\n        let accY = input.acceleration(Dimension.Y);\r\n\r\n        let radians = Math.atan2(-accX, accY);\r\n        let degrees = Math.round(radians * (180 / Math.PI));\r\n\r\n        if (degrees >= -3 && degrees <= 3) {\r\n            return 0;\r\n        }\r\n        return degrees;\r\n    }\r\n\r\n    /**\r\n     * Calculates the front tilt angle (Pitch).\r\n     * Flat = 0º, Tilted forward = positive values, tilted backward = negative values.\r\n     * Includes a stabilizing dead zone of ±3 degrees.\r\n     */\r\n    //% block=\"front tilt angle (forward/backward)\"\r\n    //% group=\"Accelerometer\"\r\n    //% weight=84\r\n    export function frontTiltAngle(): number {\r\n        let tilt = input.rotation(Rotation.Pitch);\r\n        if (tilt >= -3 && tilt <= 3) {\r\n            return 0;\r\n        }\r\n        return tilt;\r\n    }\r\n\r\n    /**\r\n     * Calculates the side tilt angle (Roll).\r\n     * Flat = 0º, Tilted left = negative values, tilted right = positive values.\r\n     * Includes a stabilizing dead zone of ±3 degrees.\r\n     */\r\n    //% block=\"side tilt angle (left/right)\"\r\n    //% group=\"Accelerometer\"\r\n    //% weight=83\r\n    export function sideTiltAngle(): number {\r\n        let tilt = input.rotation(Rotation.Roll);\r\n        if (tilt >= -3 && tilt <= 3) {\r\n            return 0;\r\n        }\r\n        return tilt;\r\n    }\r\n\r\n    // ==========================================\r\n    //              COMPASS (BUILT-IN)\r\n    // ===========================================\r\n\r\n    /**\r\n     * Returns TRUE if pointing North (0º ± 3º)\r\n     */\r\n    //% block=\"pointing North (N)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingNorth(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 357 || degrees <= 3;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if pointing Northeast (45º ± 3º)\r\n     */\r\n    //% block=\"pointing Northeast (NE)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingNortheast(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 42 && degrees <= 48;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if pointing East (90º ± 3º)\r\n     */\r\n    //% block=\"pointing East (E)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingEast(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 87 && degrees <= 93;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if pointing Southeast (135º ± 3º)\r\n     */\r\n    //% block=\"pointing Southeast (SE)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingSoutheast(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 132 && degrees <= 138;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if pointing South (180º ± 3º)\r\n     */\r\n    //% block=\"pointing South (S)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingSouth(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 177 && degrees <= 183;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if pointing Southwest (225º ± 3º)\r\n     */\r\n    //% block=\"pointing Southwest (SW)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingSouthwest(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 222 && degrees <= 228;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if pointing West (270º ± 3º)\r\n     */\r\n    //% block=\"pointing West (W)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingWest(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 267 && degrees <= 273;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if pointing Northwest (315º ± 3º)\r\n     */\r\n    //% block=\"pointing Northwest (NW)?\"\r\n    //% group=\"Compass\"\r\n    export function pointingNorthwest(): boolean {\r\n        let degrees = input.compassHeading();\r\n        return degrees >= 312 && degrees <= 318;\r\n    }\r\n\r\n    /**\r\n     * Returns TRUE if the micro:bit points to the selected cardinal point from the list.\r\n     * It uses an accuracy margin of ±3 degrees.\r\n     * @param direction The cardinal point to evaluate\r\n     */\r\n    //% block=\"pointing to $direction?\"\r\n    //% group=\"Compass\"\r\n    export function pointingTo(direction: CardinalPoint): boolean {\r\n        let degrees = input.compassHeading();\r\n\r\n        switch (direction) {\r\n            case CardinalPoint.North:\r\n                return degrees >= 357 || degrees <= 3;\r\n            case CardinalPoint.Northeast:\r\n                return degrees >= 42 && degrees <= 48;\r\n            case CardinalPoint.East:\r\n                return degrees >= 87 && degrees <= 93;\r\n            case CardinalPoint.Southeast:\r\n                return degrees >= 132 && degrees <= 138;\r\n            case CardinalPoint.South:\r\n                return degrees >= 177 && degrees <= 183;\r\n            case CardinalPoint.Southwest:\r\n                return degrees >= 222 && degrees <= 228;\r\n            case CardinalPoint.West:\r\n                return degrees >= 267 && degrees <= 273;\r\n            case CardinalPoint.Northwest:\r\n                return degrees >= 312 && degrees <= 318;\r\n            default:\r\n                return false;\r\n        }\r\n    }\r\n\r\n    // ==========================================\r\n    //           SOUND (V2) (BUILT-IN)\r\n    // ===========================================\r\n\r\n    /**\r\n     * Hexagonal block that returns TRUE if the sound level is above the limit.\r\n     * Note: Requires micro:bit V2.\r\n     * @param limit the sound level from 0 (silent) to 255 (very loud)\r\n     */\r\n    //% block=\"sound level rises above $limit?\"\r\n    //% limit.min=0 limit.max=255 limit.defl=128\r\n    //% group=\"Sound (V2)\"\r\n    export function soundAlarm(limit: number): boolean {\r\n        let currentSound = input.soundLevel();\r\n        return currentSound >= limit;\r\n    }\r\n\r\n    /**\r\n     * Hexagonal block that returns TRUE if the sound level drops below the limit.\r\n     * Note: Requires micro:bit V2.\r\n     * @param limit2 the sound level from 0 (silent) to 255 (very loud)\r\n     */\r\n    //% block=\"sound level falls below $limit2?\"\r\n    //% limit2.min=0 limit2.max=255 limit2.defl=128\r\n    //% group=\"Sound (V2)\"\r\n    export function soundAlarmDrop(limit2: number): boolean {\r\n        let currentSound = input.soundLevel();\r\n        return currentSound <= limit2;\r\n    }\r\n\r\n    // ==========================================\r\n    //          EXTERNAL SENSORS\r\n    // ==========================================\r\n\r\n    /**\r\n     * Hexagonal block that returns TRUE if the PIR sensor detects motion.\r\n     * @param pin the digital pin where the PIR is connected\r\n     */\r\n    //% block=\"PIR detects motion on $pin?\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% group=\"External Sensors\"\r\n    export function pirMotion(pin: DigitalPinOptions): boolean {\r\n        let reading = pins.digitalReadPin(<number>pin);\r\n        return reading === 1;\r\n    }\r\n\r\n    /**\r\n     * Base block: Measures distance in centimeters.\r\n     * @param pinTrig pin that emits the sound\r\n     * @param pinEcho pin that listens for the bounce\r\n     */\r\n    //% block=\"ultrasonic distance (cm) | Trig $pinTrig | Echo $pinEcho\"\r\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\r\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\r\n    //% group=\"External Sensors\"\r\n    export function measureDistance(pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): number {\r\n        pins.digitalWritePin(<number>pinTrig, 0);\r\n        control.waitMicros(2);\r\n        pins.digitalWritePin(<number>pinTrig, 1);\r\n        control.waitMicros(10);\r\n        pins.digitalWritePin(<number>pinTrig, 0);\r\n\r\n        let duration = pins.pulseIn(<number>pinEcho, PulseValue.High, 25000);\r\n        let distance = duration / 58;\r\n\r\n        if (distance <= 0 || distance > 400) {\r\n            return 0;\r\n        }\r\n        return Math.round(distance);\r\n    }\r\n\r\n    /**\r\n     * Advanced block: Measures distance choosing between cm or inches.\r\n     * @param unit choose centimeters or inches\r\n     * @param pinTrig pin that emits the sound\r\n     * @param pinEcho pin that listens for the bounce\r\n     */\r\n    //% block=\"ultrasonic distance in $unit | Trig $pinTrig | Echo $pinEcho\"\r\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\r\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\r\n    //% group=\"External Sensors\"\r\n    export function measureDistanceUnits(unit: DistanceUnit, pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): number {\r\n        let distanceCm = measureDistance(pinTrig, pinEcho);\r\n\r\n        if (unit === DistanceUnit.Centimeters) {\r\n            return distanceCm;\r\n        } else {\r\n            return Math.round(distanceCm / 2.54);\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Logic block (Hexagonal): Returns TRUE if there is an object closer than the indicated limit.\r\n     * @param limit maximum distance in cm to react\r\n     * @param pinTrig pin that emits the sound\r\n     * @param pinEcho pin that listens for the bounce\r\n     */\r\n    //% block=\"obstacle closer than $limit cm? | Trig $pinTrig | Echo $pinEcho\"\r\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\r\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\r\n    //% limit.defl=10\r\n    //% group=\"External Sensors\"\r\n    export function detectObstacle(limit: number, pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): boolean {\r\n        let distance = measureDistance(pinTrig, pinEcho);\r\n        return distance > 0 && distance <= limit;\r\n    }\r\n\r\n    /**\r\n     * Logic block (Hexagonal): Returns TRUE if there is an object further than the indicated limit.\r\n     * @param limit minimum distance in cm to react\r\n     * @param pinTrig pin that emits the sound\r\n     * @param pinEcho pin that listens for the bounce\r\n     */\r\n    //% block=\"obstacle further than $limit cm? | Trig $pinTrig | Echo $pinEcho\"\r\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\r\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\r\n    //% limit.defl=10\r\n    //% group=\"External Sensors\"\r\n    export function obstacleFurtherThan(limit: number, pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): boolean {\r\n        let distance = measureDistance(pinTrig, pinEcho);\r\n        return distance > limit || distance === 0;\r\n    }\r\n\r\n    /**\r\n     * Test block: Reads the distance and displays it on the LED screen.\r\n     * @param pinTrig pin that emits the sound\r\n     * @param pinEcho pin that listens for the bounce\r\n     */\r\n    //% block=\"show ultrasonic distance | Trig $pinTrig | Echo $pinEcho\"\r\n    //% pinTrig.fieldEditor=\"gridpicker\" pinTrig.fieldOptions.columns=3\r\n    //% pinEcho.fieldEditor=\"gridpicker\" pinEcho.fieldOptions.columns=3\r\n    //% group=\"External Sensors\"\r\n    export function showDistanceScreen(pinTrig: DigitalPinOptions, pinEcho: DigitalPinOptions): void {\r\n        let distance = measureDistance(pinTrig, pinEcho);\r\n        basic.showNumber(distance);\r\n    }\r\n\r\n    /**\r\n     * Precise reading mode (turns off LEDs)\r\n     * @param activated turns power saving mode ON or OFF\r\n     */\r\n    //% block=\"precise reading mode (turn off LEDs) $activated\"\r\n    //% activated.shadow=\"toggleOnOff\"\r\n    //% activated.defl=true\r\n    //% group=\"External Sensors\"\r\n    export function preciseReadingMode(activated: boolean): void {\r\n        if (activated) {\r\n            led.enable(false);\r\n        } else {\r\n            led.enable(true);\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Reads an external analog soil moisture sensor and returns the percentage (0-100%).\r\n     * @param pin the analog pin where the sensor's signal wire is connected\r\n     */\r\n    //% block=\"soil moisture sensor (0-100％) on $pin\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% group=\"External Sensors\"\r\n    export function readMoisture(pin: AnalogPinOptions): number {\r\n        let rawValue = pins.analogReadPin(<number>pin);\r\n        let mappedValue = Math.map(rawValue, 0, 1023, 0, 100);\r\n        return Math.round(Math.constrain(mappedValue, 0, 100));\r\n    }\r\n\r\n    /**\r\n     * Reads an external analog light sensor and returns the percentage (0-100%).\r\n     * @param pin the analog pin where the sensor's signal wire is connected\r\n     */\r\n    //% block=\"external light sensor (0-100％) on $pin\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% group=\"External Sensors\"\r\n    export function readExternalLight(pin: AnalogPinOptions): number {\r\n        let rawValue = pins.analogReadPin(<number>pin);\r\n        let mappedValue = Math.map(rawValue, 0, 1023, 0, 100);\r\n        return Math.round(Math.constrain(mappedValue, 0, 100));\r\n    }\r\n\r\n    /**\r\n     * Reads a potentiometer and returns the percentage (0-100%).\r\n     * @param pin the analog pin where the sensor's signal wire is connected\r\n     */\r\n    //% block=\"potentiometer (0-100％) on $pin\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% group=\"External Sensors\"\r\n    export function readPotentiometer(pin: AnalogPinOptions): number {\r\n        let rawValue = pins.analogReadPin(<number>pin);\r\n        let mappedValue = Math.map(rawValue, 0, 1023, 0, 100);\r\n        return Math.round(Math.constrain(mappedValue, 0, 100));\r\n    }\r\n\r\n    // ==========================================\r\n    //               ACTUATORS\r\n    // ==========================================\r\n\r\n    /**\r\n     * Turns a digital LED ON or OFF.\r\n     * @param pin the digital pin connected to the LED\r\n     * @param on ON to turn on the LED, OFF to turn it off\r\n     */\r\n    //% block=\"LED on $pin state $on\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% on.shadow=\"toggleOnOff\"\r\n    //% on.defl=true\r\n    //% group=\"Actuators\"\r\n    export function controlLed(pin: DigitalPinOptions, on: boolean): void {\r\n        pins.digitalWritePin(<number>pin, on ? 1 : 0);\r\n    }\r\n\r\n    /**\r\n     * Turns a colored LED ON or OFF.\r\n     * @param ledColor the color label of the LED\r\n     * @param pin the digital pin connected to the LED\r\n     * @param on ON to turn on the LED, OFF to turn it off\r\n     */\r\n    //% block=\"$ledColor LED on $pin state $on\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% on.shadow=\"toggleOnOff\"\r\n    //% on.defl=true\r\n    //% group=\"Actuators\"\r\n    export function controlColoredLed(ledColor: LedColor, pin: DigitalPinOptions, on: boolean): void {\r\n        pins.digitalWritePin(<number>pin, on ? 1 : 0);\r\n    }\r\n\r\n    /**\r\n     * Turns a relay ON or OFF.\r\n     * @param pin the digital pin connected to the relay\r\n     * @param on ON to turn on the relay, OFF to turn it off\r\n     */\r\n    //% block=\"relay on $pin state $on\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% on.shadow=\"toggleOnOff\"\r\n    //% on.defl=true\r\n    //% group=\"Actuators\"\r\n    export function controlRelay(pin: DigitalPinOptions, on: boolean): void {\r\n        pins.digitalWritePin(<number>pin, on ? 1 : 0);\r\n    }\r\n\r\n    /**\r\n     * Moves a servomotor to a specific angle (0 to 180 degrees).\r\n     * @param pin the pin where the servo's signal wire is connected\r\n     * @param angle the degrees to move the servo (0-180)\r\n     * @param min angle value 0, max angle value 180, default 90\r\n     */\r\n    //% block=\"move servo on $pin to $angle degrees\"\r\n    //% pin.fieldEditor=\"gridpicker\"\r\n    //% pin.fieldOptions.columns=3\r\n    //% angle.min=0 angle.max=180 angle.defl=90\r\n    //% angle.shadow=\"protractorPicker\"\r\n    //% group=\"Actuators\"\r\n    export function moveServo(pin: DigitalPinOptions, angle: number): void {\r\n        pins.servoWritePin(<number>pin, angle);\r\n    }\r\n}","README.md":"# BitModules for micro:bit\r\n\r\n**BitModules** is a Microsoft MakeCode extension that simplifies reading sensors and controlling actuators on the BBC micro:bit. It is designed to make electronics and robotics projects more accessible by providing intuitive blocks for both built-in and external components.\r\n\r\n## 🚀 Main Features\r\n\r\nThis extension divides its functions into several easy-to-use categories:\r\n\r\n* 🌡️ **Temperature and Light:** Alarms and limit readings for built-in sensors.\r\n\r\n* 🚀 **Accelerometer:** Impact force measurement (0-100%) and precise calculation of tilt angles (Pitch/Roll) with stabilized dead zones.\r\n\r\n* 🧭 **Compass:** Simplified detection of the 8 cardinal points (N, NE, E, SE, S, SW, W, NW).\r\n\r\n* 🔊 **Sound (V2 Exclusive):** Reaction blocks for noise levels.\r\n\r\n* 🔌 **External Sensors:** Optimized support for PIR motion sensors, Ultrasonic distance sensors (HC-SR04), potentiometers, soil moisture sensors, and analog light sensors.\r\n\r\n* ⚙️ **Actuators:** Direct and easy control of LEDs (with a color selector), relays, and servomotors (0-180º).\r\n\r\n## 🛠️ How to install the extension\r\n\r\nTo use this extension in your MakeCode project:\r\n\r\n1. Open [Microsoft MakeCode for micro:bit](https://makecode.microbit.org/).\r\n\r\n2. Click on **New Project**.\r\n\r\n3. In the menu, click the gear icon ⚙️ and select **Extensions** (or click \"Extensions\" in the block palette).\r\n\r\n4. In the search box, paste the URL of this repository:\r\n   `https://github.com/your-username/your-repository`\r\n\r\n5. Click on the **BitModules** card to import it into your project.\r\n\r\n> **Note:** Remember to replace `your-username/your-repository` with the actual URL of your GitHub repository once you publish it.\r\n\r\n## 💻 Usage Examples\r\n\r\n### 1. Temperature Alarm (Built-in Sensors)\r\n\r\nTriggers an alarm if the temperature rises above 30ºC.\r\n\r\n```blocks\r\nbasic.forever(function () {\r\n    if (BitModules.temperatureAlarm(30)) {\r\n        basic.showIcon(IconNames.Skull)\r\n    } else {\r\n        basic.clearScreen()\r\n    }\r\n})\r\n```\r\n\r\n### 2. Ultrasonic Distance Sensor (External Sensors)\r\n\r\nMeasures distance and activates a servomotor if an obstacle is closer than 10 cm.\r\n\r\n```blocks\r\nbasic.forever(function () {\r\n    if (BitModules.detectObstacle(10, BitModules.DigitalPinOptions.P1, BitModules.DigitalPinOptions.P2)) {\r\n        BitModules.moveServo(BitModules.DigitalPinOptions.P0, 180)\r\n    } else {\r\n        BitModules.moveServo(BitModules.DigitalPinOptions.P0, 0)\r\n    }\r\n})\r\n```\r\n\r\n### 3. Tilt and Compass (Accelerometer)\r\n\r\nShows an arrow pointing North if the board is pointing to that cardinal direction.\r\n\r\n```blocks\r\nbasic.forever(function () {\r\n    if (BitModules.pointingNorth()) {\r\n        basic.showArrow(ArrowNames.North)\r\n    }\r\n})\r\n```\r\n\r\n## ⚙️ Supported Pins Reference\r\n\r\nThe extension smartly restricts available pins to prevent conflicts with the micro:bit's internal LED matrix:\r\n\r\n* **Analog:** P0, P1, P2, P3, P4, P10.\r\n\r\n* **Digital (Safe):** P0, P1, P2, P6, P7, P8, P9, P13, P14, P16.\r\n\r\n## 🤝 Contributions\r\n\r\nContributions are welcome! If you want to improve the extension, please fork the repository, create a branch with your changes, and submit a Pull Request.\r\n\r\n## 📄 License\r\n\r\nMIT License. See the `LICENSE` file for more details.\r\n\r\n#### MakeCode Metadata (Required)\r\n\r\n* for PXT/microbit","pxt.json":"{\n    \"name\": \"BitModules\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1792298636060}